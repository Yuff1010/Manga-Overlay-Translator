# 任何 OpenAI 兼容接口均可：DeepSeek / OpenAI / 各类中转 / 本地 Ollama
#
# 第一组用无后缀的变量名。只配这一组就够用，行为和以前完全一样。
LLM_NAME=DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
# 可选：面板下拉里为这个供应商列出的多个模型（逗号分隔，留空则只列 LLM_MODEL）
LLM_MODELS=deepseek-chat,deepseek-reasoner

# 想在面板上切换多个供应商，就再加几组，后缀从 2 开始递增。
# 没有的组直接删掉即可。
#LLM_2_NAME=OpenAI
#LLM_2_BASE_URL=https://api.openai.com/v1
#LLM_2_API_KEY=sk-yyyy
#LLM_2_MODELS=gpt-4o-mini,gpt-4o

#LLM_3_NAME=本地 Ollama
#LLM_3_BASE_URL=http://127.0.0.1:11434/v1
#LLM_3_API_KEY=ollama
#LLM_3_MODELS=qwen2.5:7b,gemma2:9b

# 跨页术语一致性：LLM 对反复出现的专有名词（角色/地名/招式）建立固定译名，
# 存在服务端内存里（重启清空）并注入后续页面的翻译。设 0 关闭。
GLOSSARY=1

# ---- OCR 可选项（改后需重启；先用基准实测再换：OCRT_SLOW=1 python server/tests/bench_ocr.py）----
# 换轻量检测/识别模型提速，仅 paddleocr 3.x 生效。候选：
#   PP-OCRv6_small_det / PP-OCRv6_tiny_det / PP-OCRv5_mobile_det / PP-OCRv6_small_rec
# 实测（合成页基准）：PP-OCRv6_small_det 在 CPU 上接近提速一倍、精度无损；
# PP-OCRv5_mobile_det 对韩语有害（识别归零），韩语勿用。
#OCR_DET_MODEL=
#OCR_REC_MODEL=
# 低置信度文本行按原分辨率裁剪重试一次。默认只对韩语开（实测 recall
# 0.11 → 0.65）；=1 对所有语言开，=0 全关。
#OCR_RETRY_LOW_CONF=
